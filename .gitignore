# ==============================================================================
# TỆP : .gitignore
# Dự án: markdown_to_pdf_engine (Phiên bản v2.3.0 - Zero-Trust Git Isolation)
# Kiến trúc: Strict I/O Isolation, Test Output Shielding & Cache Blocking
# ==============================================================================

# 1. BỘ NHỚ ĐỆM TRÌNH THÔNG DỊCH VÀ BỘ KIỂM TRA TĨNH (PYTHON, RUFF & PYTEST CACHE)
__pycache__/
*.py[cod]
*$py.class
.Python
.mypy_cache/
.pytest_cache/
.ruff_cache/

# 2. MÔI TRƯỜNG ẢO VÀ BỘ NHỚ ĐỆM BỘ BẢN CHROMIUM (VIRTUAL ENV & PLAYWRIGHT)
venv/
.venv/
env/
ENV/
.playwright/
ms-playwright/

# 3. KHO NGUYÊN LIỆU ĐẦU VÀO VÀ THÀNH PHẨM PDF (LOCAL I/O ISOLATION & PRIVACY)
# Chặn tuyệt đối 100% toàn bộ tệp trong input/ và output/, chỉ giữ lại .gitkeep
input/*
!input/.gitkeep

output/*
!output/.gitkeep

# 4. KHÔNG GIAN BỘ NHỚ DÙNG MỘT LẦN VÀ TỆP RÁC PHÁT SINH TỪ BỘ TEST
temp_redteam_workspace/
*.temp.html
*.tmp
*.css.tmp
*.html
test_hybrid_output.pdf
temp/
build/
dist/

# 5. CẤU HÌNH IDE, MÔI TRƯỜNG CỤC BỘ VÀ TỆP RÁC HỆ THỐNG
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.bak
Thumbs.db
Desktop.ini

# 6. NHẬT KÝ VẬN HÀNH VÀ DỮ LIỆU CỐNG LỖI (LOGS & TRACEBACKS)
*.log
logs/
redteam_reports/
*.stacktrace
.env
config.local.yaml
