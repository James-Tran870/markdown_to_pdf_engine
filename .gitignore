# ==============================================================================
# BẢO VỆ DỮ LIỆU CÁ NHÂN & CÔ LẬP LUỒNG I/O (INPUT & OUTPUT ISOLATION v1.4.3)
# ==============================================================================

# 1. KHÓA TOÀN BỘ DỮ LIỆU ĐẦU VÀO (Giữ lại tệp giữ chỗ cấu trúc và tệp mẫu)
input/*
!input/.gitkeep
!input/input_sample.md

# 2. KHÓA TOÀN BỘ SẢN PHẨM ĐẦU RA (Giữ lại tệp giữ chỗ cấu trúc)
output/*
!output/.gitkeep

# 3. CÔ LẬP WORKSPACE KIỂM THỬ RED-TEAM VÀ TỆP TẠM CHROMIUM
temp_redteam_workspace/
*.temp.html
*.css.tmp

# 4. MÔI TRƯỜNG ẢO VÀ BỘ NHỚ ĐỆM TRÌNH DUYỆT PLAYWRIGHT
venv/
.venv/
.playwright/
ms-playwright/
__pycache__/
